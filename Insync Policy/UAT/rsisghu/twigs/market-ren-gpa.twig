                <IUWP1_COINS_DET>N</IUWP1_COINS_DET>
                <IUWP1_COINS_TP>L</IUWP1_COINS_TP>
                <IUWP1_COINS_PREM100X>Y</IUWP1_COINS_PREM100X>
