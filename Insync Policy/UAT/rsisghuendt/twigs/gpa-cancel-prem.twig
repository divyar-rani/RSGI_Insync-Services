<?xml version="1.0" encoding="UTF-8"?>
<soapenv:Envelope xmlns:soapenv="http://www.w3.org/2003/05/soap-envelope" xmlns:pol="http://policymovements.webservices.uw.rs.firstapex.com/">
    <soapenv:Header/>
    <soapenv:Body>
    {% set global_map = {
        'Group':'GR','Mid Corporate':'MC','Affinity':'AA','SF':'AA','C.N.A':'CNA','CODAN':'CO','Global Network (RSA)':'GN','Globex Underwriting Services':'GBX','HDI Gerling':'HD','Helvetia':'HV','Intact Insurance Specialty Solutions':'IT','Liberty Mutual':'LM','POHJOLA INSURANCE LTD':'PO','R+V Re':'RUV','RSA':'RS','Swiss Re':'SWRE','The Hanover Insurance Group':'HIG','Trygg Hansa':'TR','Vero Insurance':'VE','Vienna Insurance Group':'VIG','Retail Agency':'AA','Commercial':'MC','AAR':'AA','Affinity Relationship':'AA','Banca':'AA','Global':'Global','Key Broker':'MC','National Broker':'MC','Opportunity':'AA','Priority-Agency/RB':'AA','Priority-Dealer':'AA','Priority-SME':'SM','Strategic Broker':'MC'
    } %} 
    {% set policy_term = {'Short Term':'03','Short term':'03','Annualized':'01'} %} 
    {% set payment_mode = {'Cash':'CASH','Cheque':'CHQ','Bank debit':'BD','CD':'CD','BG':'BANK'} %}  
    {% set installment = {'10':'10','12':'12','3':'3','4':'4','6':'6','7':'7','9':'9','Annual':'A','Adjustment':'E','2':'H','Monthly':'M','Quarterly':'Q','Single':'S'} %} 
    {% set rag = {'Green':'G','Amber':'A','Red':'R'} %} 
    {% set taxes = {'SGST':'ZSGST','CGST':'ZCGST','IGST':'ZIGST','UGST':'ZUTGST'} %}
    {% set endt_reas = {
        'Inclusion of member':'01','Deletion of member':'01','Increase in Sum Insured':'01','Smart Endorsement':'01','Policy Cancellation':'02','Non Financial Member':'10','Change in DOB':'09','Change in Address':'10','Decrease in Sum Insured':'01','Cancellation for Re instatement':'02','Reinstate with Changes':'11','Installment collection':'09','Other Endorsement - Financial':'09','Other Endorsement - Non Financial':'10','Non Financial Member' :'10' 
    } %}		
    {% set endtNo = endorsement_no|split('-')[1]  %}
    {% set proposer_name = (eproposal.data.first_name|default(proposal.data.first_name|default('')))|replace({'&':'and'}) %}
        <pol:FGUWPolicyVO>
            <oprId>GMCPOLICY</oprId>
            <polNo>{{policy_no}}</polNo>
            <endtNo>{{endtNo}}</endtNo>
            <IUWP1_PRD_CD>APG</IUWP1_PRD_CD>
            {% if (eproposal.data.endorsement_name != 'Change in DOB') %}
                <IUWP1_ENDT_REAS>{{endt_reas[eproposal.data.endorsement_name]}}</IUWP1_ENDT_REAS>
            {% else %}
                {% if (payment.data.total_amount == 0) %}
                    <IUWP1_ENDT_REAS>10</IUWP1_ENDT_REAS>
                {% else %}
                    <IUWP1_ENDT_REAS>09</IUWP1_ENDT_REAS>
                {% endif %}
            {% endif %}
            <IUWP1_CAT_CD>D</IUWP1_CAT_CD>	       
            <IUWP1_ACC_CD>{{eproposal.data.pol_pay_acc_code.replaceAll('\\s+', '')}}</IUWP1_ACC_CD>
            <IUWP1_BR_CD>{{eproposal.data.branch_code|default(proposal.data.branch_code)}}</IUWP1_BR_CD>
            <isNewAgent>N</isNewAgent>
            <isNewClient>N</isNewClient> 
            <IUWP1_CLI_CD>{{client_id.replaceAll('\\s+', '')}}</IUWP1_CLI_CD>
            <IUWP1_POL_NO_GEN_ID>M</IUWP1_POL_NO_GEN_ID>
            <IUWP1_DOM>URB</IUWP1_DOM>
            <IUWP1_TERR>{{eproposal.data.branch_state_code|default(proposal.data.branch_state_code)}}</IUWP1_TERR> 
            <IUWP1_QUOT_NO>{{endorsement_id}}</IUWP1_QUOT_NO> 
			{% set issue_date = proposal.proposal_date  %}
            {% set issued_month = slice(issue_date, 5, 2)%}
            {% if ( issued_month < 4) %}
            <IUWP1_UWYR>{{slice(issue_date, 0, 4) - 1}}</IUWP1_UWYR>
            {%else%}
            <IUWP1_UWYR>{{slice(issue_date, 0, 4)}}</IUWP1_UWYR>
            {%endif%}
			{% if eproposal.data.imd_channel|default(proposal.data.imd_channel) == 'Global' %}
            <IUWP1_BUS_TP>{{ global_map[eproposal.data.imd_subchannel]|default(global_map[proposal.data.imd_subchannel] )}}</IUWP1_BUS_TP>{% else %}
            <IUWP1_BUS_TP>{{ global_map[eproposal.data.imd_channel]|default(global_map[proposal.data.imd_channel]) }}</IUWP1_BUS_TP>{% endif %}
            <IUWP1_ORACC_CD>{{eproposal.data.imd_oa_agent|default(proposal.data.imd_oa_agent)}}</IUWP1_ORACC_CD>	
            <IUWP1_TERM>{{ policy_term[eproposal.data.tenure_type]|default(policy_term[proposal.data.tenure_type]) }}</IUWP1_TERM>
            <IUWP1_METH_PAY>CASH</IUWP1_METH_PAY>   
            <IUWP1_INSTL_MODE>A</IUWP1_INSTL_MODE>         
            <IUWP1_NO_INST></IUWP1_NO_INST>
            <IUWP1_RN_CD>Y</IUWP1_RN_CD>
            <IUWP1_OLD_POL_NO></IUWP1_OLD_POL_NO>
            <IUWP1_SI_CUR>INR</IUWP1_SI_CUR>
            <IUWP1_PRM_CUR>INR</IUWP1_PRM_CUR>
            {% if eproposal.data.endorsement_name == 'Cancellation for Re instatement' %}
            <primeIUWP1_INCR_SI>-{{proposal.data.bk_total_si|number_format(2)}}</primeIUWP1_INCR_SI> 
            {% else %}
            <primeIUWP1_INCR_SI>{{proposal.data.bk_total_si|number_format(2)}}</primeIUWP1_INCR_SI>
            {% endif %}
            <IUWP1_POL_CREF_NO></IUWP1_POL_CREF_NO>
            <IUWP1_PLAN_NO></IUWP1_PLAN_NO>
            <IUWP1_DECLN_NO></IUWP1_DECLN_NO>
            <IUWP1_COV_NOTE_NO></IUWP1_COV_NOTE_NO>
            {% if eproposal.data.endorsement_name == 'Cancellation for Re instatement' %}
            <IUWP1_REFUND_TYPE>F</IUWP1_REFUND_TYPE>
            {% if endtNo-1 < 10 %}
            <IUWP1_ENDT_NO_REFUNDED>00{{ endtNo-1 }}</IUWP1_ENDT_NO_REFUNDED>
            {% elseif endtNo-1 < 100 and endtNo-1 >= 10 %}
            <IUWP1_ENDT_NO_REFUNDED>0{{ endtNo-1 }}</IUWP1_ENDT_NO_REFUNDED>
            {% else %}
            <IUWP1_ENDT_NO_REFUNDED>{{ endtNo-1 }}</IUWP1_ENDT_NO_REFUNDED>
            {% endif %}
            {% else %}
            <IUWP1_REFUND_TYPE/>
            <IUWP1_ENDT_NO_REFUNDED/>
             {% endif %}
            <IUWP1_EIN_NO></IUWP1_EIN_NO>
            <isNewGuardian/>
            <guardianUpdateFlag/>
            <drawerOfCheque></drawerOfCheque>
            <epMode/>
            <polNoCovNo/>
            <nameOnReceipt/>
            <hrCode/>
            <channel/>
            <panNumber>{{eproposal.data.proposer_pan|default(proposal.data.proposer_pan)}}</panNumber>
            <aadharNumber/>
            <rectType></rectType>
            <IUWP1_COV_NOTE_DT></IUWP1_COV_NOTE_DT>
            <IUWP1_ICP_DT>{{proposal.data.is_fg_policy_start_date}}</IUWP1_ICP_DT>
            <IUWP1_EXP_DT>{{proposal.data.is_fg_policy_end_date}}</IUWP1_EXP_DT>            
            <IUWP1_ISS_DT>{{proposal.data.is_fg_issue_date}}</IUWP1_ISS_DT>
            <IUWP1_ACC_DT>{{proposal.data.is_fg_acc_date}}</IUWP1_ACC_DT>
            <IUWP1_EFF_DT>{{proposal.data.is_fg_policy_start_date}}</IUWP1_EFF_DT>
            <IUWP1_PROPOSAL_DT>{{proposal.data.is_fg_proposal_date}}</IUWP1_PROPOSAL_DT> 	
			<IUWP1_DR_PR_NO>{{proposal.data.is_fg_policy_start_date}}</IUWP1_DR_PR_NO>
            <strIUWP1_ICP_TM>000001</strIUWP1_ICP_TM>
            <strIUWP1_EXP_TM>235959</strIUWP1_EXP_TM>
            {% if eproposal.data.endorsement_name == 'Cancellation for Re instatement' %}
            <clientUpdateFlag>N</clientUpdateFlag>{% else %}
            <clientUpdateFlag>Y</clientUpdateFlag>{% endif %}
            <nomineeUpdateFlag>N</nomineeUpdateFlag>
            <IUWP1_OTH_INT_PTY_CD1>{{eproposal.data.imd_code|default(proposal.data.imd_code) | upper}}</IUWP1_OTH_INT_PTY_CD1>
            <IUWP1_OTH_INT_PTY_CD2>{{eproposal.data.imd_sales_rep|default(proposal.data.imd_sales_rep) | upper}}</IUWP1_OTH_INT_PTY_CD2>
            <IUWP1_OTH_INT_PTY_CD3>{{eproposal.data.imd_approving_uw|default(proposal.data.imd_approving_uw) | upper}}</IUWP1_OTH_INT_PTY_CD3>
            <IUWP1_OTH_INT_PTY_CD4>{{eproposal.data.imd_trading_uw|default(proposal.data.imd_trading_uw) | upper}}</IUWP1_OTH_INT_PTY_CD4>
            {% set data =
                (eproposal.data.proposer_comm_addressline1|default(proposal.data.proposer_comm_addressline1|default(''))) ~ ' ' ~
                (eproposal.data.proposer_comm_addressline2|default(proposal.data.proposer_comm_addressline2|default(''))) ~ ' ' ~
                (eproposal.data.proposer_comm_addressline3|default(proposal.data.proposer_comm_addressline3|default(''))) ~ ' ' ~
                (eproposal.data.proposer_comm_addressline4|default(proposal.data.proposer_comm_addressline4|default('')))
            %}{% set data = data|replace({'&':'and'}) %}
            <IUWP1_CLI_ADDR_1>{{ data|slice(0,30) }}</IUWP1_CLI_ADDR_1>
            <IUWP1_CLI_ADDR_2>{{ data|slice(30,30) }}</IUWP1_CLI_ADDR_2>
            <IUWP1_CLI_ADDR_3>{{ data|slice(60,30) }}</IUWP1_CLI_ADDR_3>
            <IUWP1_CLI_ADDR_4>{{ data|slice(90,30) }}</IUWP1_CLI_ADDR_4> 
            <receiptNumber/>
            <voucherAmount/>
            <bankCode/>
            <cardType/>
            <vipFlag/>
            <aadharNo/>
            <eiaNo/>
            <iaNoCode/>
            <panNo>{{eproposal.data.proposer_pan|default(proposal.data.proposer_pan)}}</panNo>
            <isNewNominee/>
            <nomineeCode/>
            <nomineeDesc/>
            <relationWithProposer/>
            <relationWithProposerDesc/>
            <nomineeDOB/>
            <nomineeSex/>
            <nomineeMinorFlag/>
            <guardianCode/>
            <guardianDesc/>
            <guardianAge/>
            <relationWithNominee/>
            <relationWithNomineeDesc/>
            <nomineeAddr1/>
            <nomineeAddr2/>
            <nomineeAddr3/>
            <nomineeAddr4/>
            <IUWP1_ENQ_KEY_2>{{eproposal.data.branch_gst_no|default(proposal.data.branch_gst_no)}}</IUWP1_ENQ_KEY_2>
            <IUWP1_POL_WARR>{{eproposal.data.is_fg_policy_no|default(proposal.data.is_fg_policy_no)}}</IUWP1_POL_WARR>
            <IUWP1_DED_TXT1></IUWP1_DED_TXT1>
            <IUWP1_DED_TXT2></IUWP1_DED_TXT2>
            <IUWP1_DED_TXT3></IUWP1_DED_TXT3>
            <IUWP1_DED_TXT4></IUWP1_DED_TXT4>
            <IUWP1_DED_TXT5></IUWP1_DED_TXT5>
            <IUWP1_COINS_DET></IUWP1_COINS_DET>
            <IUWP1_COINS_TP></IUWP1_COINS_TP>
            <IUWP1_COINS_LEADER></IUWP1_COINS_LEADER>
            <IUWP1_CES_X></IUWP1_CES_X>
            <IUWP1_COINS_LEADER_SHAREX></IUWP1_COINS_LEADER_SHAREX>
            <IUWP1_COINS_PREM100X></IUWP1_COINS_PREM100X>
            <IUWP1_COINS_CLAIM100X></IUWP1_COINS_CLAIM100X>
            <IUWP1_LINK_FLD>{{eproposal_no}}</IUWP1_LINK_FLD>
            <custSegment/>
            <IUWP1_QUOT_NO>{{endorsement_id}}</IUWP1_QUOT_NO>
            {% if proposal.data.policy_transaction_type == "New Business" %}<IUWP1_DELIVERY_MODE>N</IUWP1_DELIVERY_MODE>{% else %}<IUWP1_DELIVERY_MODE>EDR</IUWP1_DELIVERY_MODE>{% endif %}           
            <IUWP1_CUSTOMERSEGMENT/>
            <clientVO>
                <IUWPC_PREFIX1></IUWPC_PREFIX1>
                <IUWPC_FIRSTNAME2>{{slice(proposer_name,0,30)}}</IUWPC_FIRSTNAME2>
                <IUWPC_OTHRNAME2/>
                <IUWPC_SURNAME2>{{slice(proposer_name,30,30)}}</IUWPC_SURNAME2>
                {% if (eproposal.data.cust_buss_type |default(proposal.data.cust_buss_type) == 'Entity')%}<IUWPC_CLI_TP>O</IUWPC_CLI_TP>                                      
                {% else %}<IUWPC_CLI_TP>I</IUWPC_CLI_TP>{%endif%} 
                <IUWPC_HM_PHONE/>
               <IUWPC_CLI_EMAIL1>{{eproposal.data.email|default(proposal.data.email)}}</IUWPC_CLI_EMAIL1>
                <IUWPC_HAND_PHONE/>
                <IUWPC_OFF_PHONE/>
                <cityCode>{{eproposal.data.proposer_comm_city_code|default(proposal.data.proposer_comm_city_code)}}</cityCode>	
                <IUWPC_STATE_CD>{{eproposal.data.proposer_comm_state_code|default(proposal.data.proposer_comm_state_code)}}</IUWPC_STATE_CD> 
                <IUWPC_2ND_ZIP>{{eproposal.data.proposer_comm_pincode|default(proposal.data.proposer_comm_pincode)}}</IUWPC_2ND_ZIP>
                <IUWPC_CON_CD>IND</IUWPC_CON_CD>
                <IUWPC_DOB/>
                <IUWPC_SEX/>
                <IUWPC_CAMPAIGN/>
                <IUWPC_TRADE>1000</IUWPC_TRADE>
                <IUWPC_MARITAL_STATUS/>
            </clientVO>
            {# Zero or more repetitions: #}
            {% for tax in proposal.data.tax_details.tax_parts|default([]) %}                
                <policyCoverageVOList>
                <IUWP4_COVG_CD>{{ taxes[tax.name] }}</IUWP4_COVG_CD>
                <IUWP4_PREM_CURR>INR</IUWP4_PREM_CURR>
                <IUWP4_PREM_CURR_RATE>1</IUWP4_PREM_CURR_RATE>
                <IUWP4_RT_U>{{tax.rate}}</IUWP4_RT_U>
                {% if eproposal.data.endorsement_name == 'Cancellation for Re instatement' %}
                <primeIUWP4_NEW_INCR_PREM>-{{ tax.value|number_format(2) }}</primeIUWP4_NEW_INCR_PREM>
                {% else %}
                <primeIUWP4_NEW_INCR_PREM>{{ tax.value|number_format(2) }}</primeIUWP4_NEW_INCR_PREM>
                {% endif %}
                </policyCoverageVOList>                
            {% endfor %}
            {% if proposal.data.bk_broker_commission > 0 %}
                <policyCoverageVOList>
                    <IUWP4_COVG_CD>ZOVCM</IUWP4_COVG_CD>
                    <IUWP4_PREM_CURR>INR</IUWP4_PREM_CURR>
                    <IUWP4_PREM_CURR_RATE>1</IUWP4_PREM_CURR_RATE>
                    <IUWP4_RT_U>{{ proposal.data.bk_broker_commission }}</IUWP4_RT_U>
                    <primeIUWP4_NEW_INCR_PREM/>
                </policyCoverageVOList>    
            {% endif %} 
            {% if proposal.data.calc_tpa_fees != 0 %}                
                <policyCoverageVOList>
                <IUWP4_COVG_CD>ZTPAFE</IUWP4_COVG_CD>
                <IUWP4_PREM_CURR>INR</IUWP4_PREM_CURR>
                <IUWP4_PREM_CURR_RATE>1</IUWP4_PREM_CURR_RATE>
                <IUWP4_RT_U>{{proposal.data.actual_tpa_commision}}</IUWP4_RT_U>
                {% if eproposal.data.endorsement_name == 'Cancellation for Re instatement' %}
                <primeIUWP4_NEW_INCR_PREM>-{{proposal.data.calc_tpa_fees|number_format(2)}}</primeIUWP4_NEW_INCR_PREM>
                {% else %}
                <primeIUWP4_NEW_INCR_PREM>{{proposal.data.calc_tpa_fees|number_format(2)}}</primeIUWP4_NEW_INCR_PREM>
                {% endif %}
                </policyCoverageVOList>                
            {% endif %}
            {% if proposal.data.total_discount != 0 %}
                <policyCoverageVOList>
                <IUWP4_COVG_CD>ZDISC</IUWP4_COVG_CD>
                <IUWP4_PREM_CURR>INR</IUWP4_PREM_CURR>
                <IUWP4_PREM_CURR_RATE>1</IUWP4_PREM_CURR_RATE>
                <IUWP4_RT_U></IUWP4_RT_U>
                {% if eproposal.data.endorsement_name == 'Cancellation for Re instatement' %}
                <primeIUWP4_NEW_INCR_PREM>{{ (proposal.data.total_discount * -1)|number_format(0) | default((proposal.data.uw_quantum_discount_value * -1)|number_format(0)) }}</primeIUWP4_NEW_INCR_PREM>
                {% else %}
                <primeIUWP4_NEW_INCR_PREM>{{ (proposal.data.total_discount)|number_format(0) | default((proposal.data.uw_quantum_discount_value)|number_format(0)) }}</primeIUWP4_NEW_INCR_PREM>
                {% endif %}
                </policyCoverageVOList>                 
            {% endif %}		
{% if proposal.data.policy_transaction_type != 'New Business' %}
    {% if proposal.data.sme_flag == "SME" %}
        {% set limbs_premium = proposal.data.ren_sme_limbs_premium | default(0) %}
        {% if proposal.data.ren_sme_ttd_premium == '' %}
            {% set ttd_total_premium = limbs_premium * 1 %}
        {% elseif limbs_premium == '' %}
            {% set ttd_total_premium = proposal.data.ren_sme_ttd_premium * 1 %}
        {% else %}
            {% set ttd_total_premium = (proposal.data.ren_sme_ttd_premium * 1) + (limbs_premium * 1) %}
        {% endif %}
        {% if proposal.data.addon_medical_expense_type | lower == 'standard' %}
            {% set medex_premium = proposal.data.ren_sme_std_med_premium | default(0) %}
        {% elseif proposal.data.addon_medical_expense_type | lower == 'delinked' %}
            {% set medex_premium = proposal.data.ren_sme_delink_premium | default(0) %}
        {% else %}
            {% set medex_premium = proposal.data.ren_sme_both_premium | default(0) %}
        {% endif %}
        {% set base_coverage_premium = (proposal.data.ren_sme_death_premium | default(0)) + 0 %}
        {% set covers = [
            {"code":"APDPRM","si":proposal.data.bk_total_pa_si,"flag":proposal.data.addon_death,"premium":base_coverage_premium,"rate":""},
            {"code":"APSPRM","si":proposal.data.bk_total_pa_si,"flag":proposal.data.addon_ptd,"premium":proposal.data.ren_sme_ptd_premium,"rate":""},
            {"code":"APPPRM","si":proposal.data.bk_total_pa_si,"flag":proposal.data.addon_ppd,"premium":proposal.data.ren_sme_ppd_premium,"rate":""},
            {"code":"APGTPR","si":proposal.data.bk_total_pa_si,"flag":proposal.data.addon_ttd or proposal.data.addon_loss_of_limbs,"premium":ttd_total_premium,"rate":""},
            {"code":"APMPRM","si":proposal.data.bk_t_std_addon_si,"flag":proposal.data.addon_medical_exp,"premium":medex_premium,"rate":""},
            {"code":"APEDG","si":proposal.data.child_benefit_si,"flag":proposal.data.addon_child_benefits,"premium":0,"rate":""},
            {"code":"ACLOD","si":proposal.data.ambulance_addon_si,"flag":proposal.data.addon_ambulance,"premium":0,"rate":""},
            {"code":"APGMB","si":proposal.data.modification_si,"flag":proposal.data.addon_modification,"premium":0,"rate":""},
            {"code":"APGFT","si":proposal.data.family_trans_si,"flag":proposal.data.addon_family_trans_benefit,"premium":0,"rate":""},
            {"code":"TRTROR","si":proposal.data.trans_mortal_si,"flag":proposal.data.addon_repatriation_mortal_remains,"premium":0,"rate":""},
            {"code":"APCCE","si":proposal.data.funeral_si,"flag":proposal.data.addon_funeral_expenses,"premium":0,"rate":""}
        ] %}
    {% else %}
        {% set limbs_premium = proposal.data.ren_limbs_f_premium | default(0) %}
        {% if proposal.data.ren_final_ttd_premium == '' %}
            {% set ttd_total_premium = limbs_premium * 1 %}
        {% elseif limbs_premium == '' %}
            {% set ttd_total_premium = proposal.data.ren_final_ttd_premium * 1 %}
        {% else %}
            {% set ttd_total_premium = (proposal.data.ren_final_ttd_premium * 1) + (limbs_premium * 1) %}
        {% endif %}
        {% set medex_premium = proposal.data.ren_medical_expense_premium | default(0) %}
        {% set base_coverage_premium = proposal.data.ren_death_cover_premium | default(0) %}
        {% set covers = [
            {"code":"APDPRM","si":proposal.data.bk_total_pa_si,"flag":proposal.data.addon_death,"premium":base_coverage_premium,"rate":""},
            {"code":"APSPRM","si":proposal.data.bk_total_pa_si,"flag":proposal.data.addon_ptd,"premium":proposal.data.ren_ptd_f_premium,"rate":""},
            {"code":"APPPRM","si":proposal.data.bk_total_pa_si,"flag":proposal.data.addon_ppd,"premium":proposal.data.ren_ppd_f_premium,"rate":""},
            {"code":"APGTPR","si":proposal.data.bk_total_pa_si,"flag":proposal.data.addon_ttd or proposal.data.addon_loss_of_limbs,"premium":ttd_total_premium,"rate":""},
            {"code":"APMPRM","si":proposal.data.bk_t_std_addon_si,"flag":proposal.data.addon_medical_exp,"premium":medex_premium,"rate":""},
            {"code":"APEDG","si":proposal.data.child_benefit_si,"flag":proposal.data.addon_child_benefits,"premium":proposal.data.ren_child_education_premium,"rate":""},
            {"code":"ACLOD","si":proposal.data.ambulance_addon_si,"flag":proposal.data.addon_ambulance,"premium":proposal.data.ren_ambulance_premium,"rate":""},
            {"code":"APGMB","si":proposal.data.modification_si,"flag":proposal.data.addon_modification,"premium":proposal.data.ren_modification_benefits_premium,"rate":""},
            {"code":"APGFT","si":proposal.data.family_trans_si,"flag":proposal.data.addon_family_trans_benefit,"premium":proposal.data.ren_family_trans_premium,"rate":""},
            {"code":"TRTROR","si":proposal.data.trans_mortal_si,"flag":proposal.data.addon_repatriation_mortal_remains,"premium":proposal.data.ren_repatriations_premium,"rate":""},
            {"code":"APCCE","si":proposal.data.funeral_si,"flag":proposal.data.addon_funeral_expenses,"premium":proposal.data.ren_funeral_expense_premium,"rate":""}
        ] %}
    {% endif %}
{% else %}
	{% if proposal.data.sme_flag == "SME" %}
        {% set funeral_premium = 0 %}
        {% set limbs_premium = 0 %}
    {% else %}
        {% set funeral_premium = proposal.data.funeral_expense_premium | default(0) %}
        {% set limbs_premium = proposal.data.limbs_f_premium | default(0) %}
    {% endif %}
    {% set ttd_total_premium = (proposal.data.final_ttd_premium | default(0)) + limbs_premium %}
    {% set medex_premium = proposal.data.medical_expense_premium | default(0) %}
    {% set base_coverage_premium = proposal.data.death_cover_premium | default(0) %}
    {% set covers = [
